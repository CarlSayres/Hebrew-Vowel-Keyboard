<Window x:Class="HebrewVowelKeyboard.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hebrew Marks" Width="306" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" Background="#F7F8FA" Foreground="#162B3B"
 Topmost="True" ShowActivated="False" FontFamily="Segoe UI"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Focusable" Value="False" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Background" Value="White" />
   <Setter Property="BorderBrush" Value="#DCE3E8" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="Padding" Value="10,6" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="#E5F3F0" />
        <Setter TargetName="Frame" Property="BorderBrush" Value="#218675" />
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="#C9E6DF" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <DataTemplate x:Key="MarkTemplate">
   <Button Width="92" Height="78" Margin="2" Padding="2" Tag="{Binding}" FlowDirection="LeftToRight"
    Click="InsertMark" AutomationProperties.Name="{Binding Description}">
    <StackPanel>
     <Grid Width="40" Height="40">
      <TextBlock x:Name="PreviewText" Text="{Binding Preview}" FontFamily="Times New Roman" FontSize="32"
       TextAlignment="Center" FlowDirection="LeftToRight" />
      <Ellipse x:Name="PreviewDot" Width="3" Height="3" Fill="#162B3B"
       HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
     </Grid>
     <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" />
     <TextBlock Text="{Binding HebrewName}" FontSize="11" Foreground="#667785" TextAlignment="Center"
      FlowDirection="RightToLeft" Margin="0,1,0,0" />
    </StackPanel>
   </Button>
   <!-- Position these dots over the preview circle directly: shaping a Hebrew
        letter-specific dot against U+25CC can synthesize a second dotted circle. -->
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Id}" Value="shin-dot">
     <Setter TargetName="PreviewText" Property="Text" Value="◌" />
     <Setter TargetName="PreviewDot" Property="Visibility" Value="Visible" />
     <Setter TargetName="PreviewDot" Property="Margin" Value="27,7,0,0" />
    </DataTrigger>
    <DataTrigger Binding="{Binding Id}" Value="sin-dot">
     <Setter TargetName="PreviewText" Property="Text" Value="◌" />
     <Setter TargetName="PreviewDot" Property="Visibility" Value="Visible" />
     <Setter TargetName="PreviewDot" Property="Margin" Value="10,7,0,0" />
    </DataTrigger>
    <DataTrigger Binding="{Binding Id}" Value="holam-haser">
     <Setter TargetName="PreviewText" Property="Text" Value="◌" />
     <Setter TargetName="PreviewDot" Property="Visibility" Value="Visible" />
     <Setter TargetName="PreviewDot" Property="Margin" Value="10,7,0,0" />
    </DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="RowTemplate">
   <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource MarkTemplate}"
    HorizontalAlignment="Right" FlowDirection="RightToLeft">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   </ItemsControl>
  </DataTemplate>
 </Window.Resources>
 <Border BorderThickness="1" BorderBrush="#BECBD4">
  <StackPanel>
   <Border Background="#172F40" Padding="12,9,10,9" MouseLeftButtonDown="DragHeader">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="Niqqud &amp; Te’amim" Foreground="White" FontSize="18" IsHitTestVisible="False" />
     <TextBlock Grid.Row="1" x:Name="ShortcutText" Text="Ctrl-Alt-H to show or hide" Foreground="#B2DBD2" FontSize="10"
      Margin="0,8,133,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" />
     <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
      <Button x:Name="NiqqudTab" Content="Niqqud" Tag="Niqqud" Click="ChangeGroup" Margin="0,0,5,0" />
      <Button x:Name="TeamimTab" Content="Te’amim" Tag="Te'amim" Click="ChangeGroup" />
     </StackPanel>
     <Grid Grid.Row="2" Margin="0,7,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="KeyboardStatus" Text="Keyboard: —" Foreground="#B2DBD2" FontSize="11"
       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" IsHitTestVisible="False" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="HebrewKeyboardButton" Content="עברית" FontSize="11" Padding="9,4" Margin="0,0,5,0"
        Click="SelectHebrewKeyboard" AutomationProperties.Name="Select Hebrew keyboard in active editor" />
       <Button x:Name="EnglishKeyboardButton" Content="English" FontSize="11" Padding="9,4"
        Click="SelectEnglishKeyboard" AutomationProperties.Name="Select English keyboard in active editor" />
      </StackPanel>
     </Grid>
     <Button Content="✕" Width="26" Height="26" Padding="0" HorizontalAlignment="Right"
      Background="#EAF0F4" Click="ClosePalette" AutomationProperties.Name="Close Hebrew Marks" />
    </Grid>
   </Border>
   <ItemsControl x:Name="MarkButtons" ItemTemplate="{StaticResource RowTemplate}" Margin="8,6" />
  </StackPanel>
 </Border>
</Window>
